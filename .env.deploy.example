# Copy to .env.deploy (git ignores it) and fill in, for `make deploy`.
# The address stays out of the repo: it is public, and the origin's IP is
# best known only to Cloudflare.
DEPLOY_HOST=ubuntu@<server-static-ip>
DEPLOY_KEY=~/.ssh/mentora-lightsail
DEPLOY_DIR=/opt/mentora
DEPLOY_URL=https://mentora.stream
